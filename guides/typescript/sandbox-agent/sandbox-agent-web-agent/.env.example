# Required: Daytona API key from https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=

# At least one model provider key is required
OPENAI_API_KEY=
# CODEX_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: set a specific agent ID to install/use (for example: codex, claude)
# AGENT=

# Optional: override the snapshot name (defaults to "sandbox-agent-${AGENT}")
# SNAPSHOT_NAME=
